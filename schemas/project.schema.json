{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:ai-video-skills:project:1",
  "title":"AI Video Skills project v1",
  "type":"object",
  "additionalProperties":false,
  "required":["schemaVersion","id","title","width","height","fps","scenes"],
  "properties":{
    "schemaVersion":{"const":1},
    "id":{"$ref":"#/$defs/id"},
    "title":{"type":"string","minLength":1,"maxLength":300},
    "language":{"type":"string","minLength":1,"maxLength":30},
    "width":{"type":"integer","minimum":64,"maximum":3840,"multipleOf":2},
    "height":{"type":"integer","minimum":64,"maximum":3840,"multipleOf":2},
    "fps":{"type":"integer","minimum":15,"maximum":60},
    "captionMode":{"enum":["sidecar","burn","none"]},
    "font":{"$ref":"#/$defs/path"},
    "fontFamily":{"type":"string","minLength":1,"maxLength":100,"pattern":"^[^,\\\\{}\\r\\n]+$"},
    "scenes":{"type":"array","minItems":1,"maxItems":2000,"items":{"$ref":"#/$defs/scene"}},
    "subtitles":{"type":"array","maxItems":100000,"items":{"type":"object","additionalProperties":false,"required":["start","end","text"],"properties":{"start":{"type":"number","minimum":0},"end":{"type":"number","exclusiveMinimum":0},"text":{"type":"string","minLength":1,"maxLength":1000}}}},
    "audio":{"type":"object","additionalProperties":false,"properties":{"music":{"$ref":"#/$defs/path"},"musicDb":{"type":"number","minimum":-60,"maximum":6},"voiceDb":{"type":"number","minimum":-60,"maximum":6}}},
    "provenance":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["path","source"],"properties":{"path":{"$ref":"#/$defs/path"},"source":{"type":"string","minLength":1,"maxLength":10000},"license":{"type":"string","minLength":1,"maxLength":10000},"prompt":{"type":"string","minLength":1,"maxLength":10000}}}}
  },
  "$defs":{
    "id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{0,63}$"},
    "path":{"type":"string","minLength":1,"maxLength":1000,"pattern":"^(?!/)(?![A-Za-z]+:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"},
    "scene":{
      "type":"object","additionalProperties":false,"required":["id","duration"],
      "oneOf":[{"required":["image"],"not":{"required":["color"]}},{"required":["color"],"not":{"required":["image"]}}],
      "properties":{
        "id":{"$ref":"#/$defs/id"},
        "duration":{"type":"number","exclusiveMinimum":0,"maximum":600},
        "image":{"$ref":"#/$defs/path"},
        "imagePrompt":{"type":"string","minLength":1,"maxLength":10000},
        "color":{"type":"string","pattern":"^#[0-9a-fA-F]{6}$"},
        "camera":{"enum":["static","zoom-in","zoom-out","pan-left","pan-right"]},
        "transition":{"enum":["cut","fade"]},
        "narration":{"type":"string"},
        "audio":{"$ref":"#/$defs/path"}
      }
    }
  },
  "$comment":"Engine additionally enforces frame alignment, unique ids, two-hour total bound, non-overlapping in-range cues, realpath confinement and narration duration checks. JSON Schema alone is insufficient."
}
